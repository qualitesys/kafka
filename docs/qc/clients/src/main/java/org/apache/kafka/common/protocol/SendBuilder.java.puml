@startuml
!pragma layout smetana
Writable <|-- org.apache.kafka.common.protocol.SendBuilder
class org.apache.kafka.common.protocol.SendBuilder {
+  SendBuilder(int)
+  writeByte(byte)
+  writeShort(short)
+  writeInt(int)
+  writeLong(long)
+  writeDouble(double)
+  writeByteArray(byte[])
+  writeUnsignedVarint(int)
+  writeByteBuffer(ByteBuffer)
+  writeVarint(int)
+  writeVarlong(long)
+  addBuffer(ByteBuffer)
+  addSend(Send)
+  clearBuffers()
+  writeRecords(BaseRecords)
+  flushPendingSend()
+  flushPendingBuffer()
+  build()
+  buildRequestSend(RequestHeader;Message)
+  buildResponseSend(ResponseHeader;Message;short)
+  buildSend(Message;short;Message;short)
} 
@enduml
